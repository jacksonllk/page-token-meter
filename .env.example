# Copy this file to .env and fill in the values. Never commit .env.

# Required. Your context.dev API key.
CONTEXT_DEV_API_KEY=

# Optional. Upstash Redis for the 24-hour cache and share links. Without it, they are kept in memory until restart.
# Adding Upstash through the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN instead. Both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hosted demo only. Leave both empty on your own copy: no limits.
# The most context.dev credits the whole site spends per day (UTC). Then live checks stop for everyone until tomorrow.
DAILY_CREDIT_CAP=
# The most credits one visitor (IP address) spends per day. Saved results and share links are free and do not count.
VISITOR_DAILY_CREDITS=

# Optional. The most pages a Whole website check measures. Empty: 8. Each page costs 1 credit.
MAX_KEY_PAGES=

# Optional. Set to "off" to stop every live context.dev call. Saved results are still served.
LIVE_CHECKS=
